<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta translúcida destacada con borde dorado: efecto "vidrio destacado" -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0FFFFFFF" /> <!-- blanco al 6% de opacidad -->
    <stroke
        android:width="1dp"
        android:color="#4DF5C55A" /> <!-- dorado al 30% -->
    <corners android:radius="20dp" />
</shape>