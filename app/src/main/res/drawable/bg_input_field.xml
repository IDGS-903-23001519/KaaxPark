<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#3A1A1E22"
                android:centerColor="#2E171B1F"
                android:endColor="#22101214" />
            <stroke
                android:width="1.5dp"
                android:color="@color/gold_primary" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#331A1E22"
                android:centerColor="#26171B1F"
                android:endColor="#1F101214" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
