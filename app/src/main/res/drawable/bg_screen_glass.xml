<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo base negro con dos resplandores radiales dorados, simulando el "humo" del login -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base negra -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0A" />
        </shape>
    </item>

    <!-- Resplandor superior izquierdo -->
    <item android:gravity="top|start">
        <shape android:shape="oval">
            <size android:width="420dp" android:height="420dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="210dp"
                android:centerColor="#333A2A10"
                android:startColor="#663A2A10"
                android:endColor="#000A0A0A" />
        </shape>
    </item>

    <!-- Resplandor inferior derecho -->
    <item android:gravity="bottom|end">
        <shape android:shape="oval">
            <size android:width="400dp" android:height="400dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="200dp"
                android:centerColor="#2A2A1F0A"
                android:startColor="#552A1F0A"
                android:endColor="#000A0A0A" />
        </shape>
    </item>

</layer-list>