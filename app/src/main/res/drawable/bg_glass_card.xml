<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta translúcida con borde tenue blanco: efecto "vidrio" base -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0FFFFFFF" /> <!-- blanco al 6% de opacidad -->
    <stroke
        android:width="1dp"
        android:color="#1AFFFFFF" /> <!-- blanco al 10% -->
    <corners android:radius="18dp" />
</shape>