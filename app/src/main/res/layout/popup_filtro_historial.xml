<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:elevation="8dp">

    <TextView
        android:id="@+id/opcionTodos"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="15dp"
        android:text="Todos los registros"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"/>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" />

    <TextView
        android:id="@+id/opcionHoy"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="15dp"
        android:text="Hoy"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"/>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" />

    <TextView
        android:id="@+id/opcionAyer"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="15dp"
        android:text="Ayer"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"/>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" />

    <TextView
        android:id="@+id/opcionSemana"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="15dp"
        android:text="Esta semana"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"/>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" />

    <TextView
        android:id="@+id/opcionMes"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="15dp"
        android:text="Este mes"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"/>

</LinearLayout>