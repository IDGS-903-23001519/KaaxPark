<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Cliente.Codigoqr"
    android:background="@drawable/bg_screen_glass">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:text="Escanear código"
                android:textColor="#F5C55A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Paso 1: escanear el código QR de la entrada -->
            <LinearLayout
                android:id="@+id/contenedorEscaneo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="40dp"
                    android:gravity="center"
                    android:text="Apunta con la cámara al código QR de la entrada"
                    android:textColor="#8CFFFFFF"
                    android:textSize="14sp" />

                <!-- Tarjeta de vidrio que envuelve la cámara, con borde dorado -->
                <FrameLayout
                    android:id="@+id/contenedorCamara"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:layout_marginTop="40dp"
                    android:padding="18dp"
                    android:background="@drawable/bg_glass_card_gold"
                    android:elevation="0dp">

                    <LinearLayout
                        android:id="@+id/btnIniciarEscaneo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:background="#4D000000"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:alpha="0.25"
                            android:src="@drawable/icon_codigoqr" />

                    </LinearLayout>

                    <!-- Marco de esquinas doradas -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/marcador_qr" />

                    <!-- Línea de escaneo animada -->
                    <View
                        android:id="@+id/lineaEscaneo"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_scan_line" />

                </FrameLayout>


            </LinearLayout>

            <!-- Paso 2: elegir el vehículo con el que se viene (solo aparece después de escanear) -->
            <LinearLayout
                android:id="@+id/contenedorSeleccionVehiculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="24dp"
                android:padding="16dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Código válido. Selecciona el vehículo\ncon el que vienes"
                    android:textColor="#E0E0E0"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/contenedorVehiculosQR"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txtVolverEscaneo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="‹ Volver a escanear el código"
                    android:textColor="#F5C55A"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="10dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtResultadoAsignacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="30dp"
                android:gravity="center"
                android:text=""
                android:textColor="#F5C55A"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
