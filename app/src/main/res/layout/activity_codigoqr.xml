<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Cliente.Codigoqr">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="Escanear Código QR"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Paso 1: escanear el código QR de la entrada -->
            <LinearLayout
                android:id="@+id/contenedorEscaneo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35dp"
                    android:layout_marginHorizontal="40dp"
                    android:gravity="center"
                    android:text="Escanea el código Qr en la\npantalla de entrada"
                    android:textColor="#E0E0E0"
                    android:textSize="16sp"
                    android:textStyle="italic" />

                <FrameLayout
                    android:id="@+id/contenedorCamara"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:layout_marginTop="35dp"
                    android:background="@drawable/bg_dialog"
                    android:elevation="4dp">

                    <LinearLayout
                        android:id="@+id/btnIniciarEscaneo"
                        android:layout_width="244dp"
                        android:layout_height="246dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="244dp"
                            android:layout_height="195dp"
                            android:src="@drawable/icon_codigoqr" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Toca para escanear"
                            android:textColor="#D4A017"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/marcador_qr" />

                </FrameLayout>

            </LinearLayout>

            <!-- Paso 2: elegir el vehículo con el que se viene (solo aparece después de escanear) -->
            <LinearLayout
                android:id="@+id/contenedorSeleccionVehiculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginHorizontal="30dp"
                    android:gravity="center"
                    android:text="Código válido. Selecciona el vehículo\ncon el que vienes"
                    android:textColor="#E0E0E0"
                    android:textSize="16sp"
                    android:textStyle="italic" />

                <LinearLayout
                    android:id="@+id/contenedorVehiculosQR"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginHorizontal="20dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txtVolverEscaneo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="‹ Volver a escanear el código"
                    android:textColor="#D4A017"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="10dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtResultadoAsignacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="30dp"
                android:gravity="center"
                android:text=""
                android:textColor="#D4A017"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
