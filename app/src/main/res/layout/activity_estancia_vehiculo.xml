<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Cliente.EstanciaVehiculo"
    android:background="@drawable/bg_screen_glass">

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:text="Mi Estancia"
        android:textColor="#FDFDFD"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtSubtitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="32dp"
        android:text="Tu vehículo está estacionado"
        android:textColor="#8CFFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo" />

    <LinearLayout
        android:id="@+id/containerCronometro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="25dp"
        android:background="@drawable/bg_glass_card_gold"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="25dp"
        app:layout_constraintTop_toBottomOf="@id/txtSubtitulo">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiempo estacionado"
            android:textColor="#8CFFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtTiempoMarcador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="02:45:18"
            android:textColor="#F5C55A"
            android:textSize="48sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Horas"
                android:textColor="#8CFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Minutos"
                android:textColor="#8CFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Segundos"
                android:textColor="#8CFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerDetalleVehiculo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="25dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/containerCronometro">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:paddingHorizontal="15dp"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/icRowLugar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_centerVertical="true"
                android:src="@drawable/icon_lugar"
                app:tint="#F5C55A" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/icRowLugar"
                android:layout_marginStart="15dp"
                android:layout_centerVertical="true"
                android:text="Lugar asignado"
                android:textColor="#FDFDFD"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/txtDetalleLugar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="n1c1"
                android:textColor="#F5C55A"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:paddingHorizontal="15dp"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/icRowVehiculo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_centerVertical="true"
                android:src="@drawable/icon_vehiculo"
                app:tint="#F5C55A" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/icRowVehiculo"
                android:layout_marginStart="15dp"
                android:layout_centerVertical="true"
                android:text="Vehículo"
                android:textColor="#FDFDFD"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/txtDetalleMarca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Toyota"
                android:textColor="#F5C55A"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:paddingHorizontal="15dp"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/icPlaca"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_centerVertical="true"
                android:src="@drawable/icon_placa"
                app:tint="#F5C55A" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/icPlaca"
                android:layout_marginStart="15dp"
                android:layout_centerVertical="true"
                android:text="Placa"
                android:textColor="#FDFDFD"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/txtDetallePlaca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="YUC-123-A"
                android:textColor="#F5C55A"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1AFFFFFF" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:paddingHorizontal="15dp"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/icRowColor"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_centerVertical="true"
                android:src="@drawable/icon_color"
                app:tint="#F5C55A" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/icRowColor"
                android:layout_marginStart="15dp"
                android:layout_centerVertical="true"
                android:text="Color"
                android:textColor="#FDFDFD"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/txtDetalleColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Gris"
                android:textColor="#F5C55A"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnActualizar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/bg_button_gold"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/containerDetalleVehiculo">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/icon_actualizar"
            app:tint="#241705" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actualizar"
            android:textColor="#241705"
            android:textStyle="bold"
            android:textSize="17sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
