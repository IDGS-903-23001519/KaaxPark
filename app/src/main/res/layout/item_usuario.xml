<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginStart="15dp"
    android:layout_marginEnd="15dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imgUserAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/icon_perfil"
        android:layout_gravity="center_vertical"
        app:tint="#F5C55A" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lblNombreUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leslie Michelle"
            android:textColor="#FDFDFD"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/lblCorreoUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="leslimichel471@gmail.com"
            android:textColor="#8CFFFFFF"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/lblRolTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rol: Usuario"
            android:textColor="#8CFFFFFF"
            android:textSize="11sp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_chip"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/dotEstadoFila"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/indicador_estado_circular"/>

        <TextView
            android:id="@+id/lblEstadoTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inactivo"
            android:textColor="#F5C55A"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/imgFlechaIr"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/icon_flecha"
        app:tint="#8CFFFFFF"/>

</LinearLayout>