<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@drawable/icon_carro_historial"
        app:tint="#F5C55A" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtItemFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15/05/2026"
            android:textColor="#FDFDFD"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtItemHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="03:18 PM"
            android:textColor="#8CFFFFFF"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/txtItemCajon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cajón: n1c1"
            android:textColor="#8CFFFFFF"
            android:textSize="11sp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/txtItemMonto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$45.00"
        android:textColor="#F5C55A"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/icon_flecha"
        app:tint="#8CFFFFFF"/>

</LinearLayout>