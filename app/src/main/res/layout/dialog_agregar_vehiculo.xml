<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Agregar vehículo"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="18dp"
        android:text="Completa los datos de tu auto"
        android:textColor="#AAAAAA"
        android:textSize="13sp" />

    <!-- Marca -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MARCA"
        android:textColor="#D4A017"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <EditText
        android:id="@+id/txtMarcaDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="Ej. Nissan"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="15sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:inputType="textCapWords" />

    <!-- Modelo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="MODELO (OPCIONAL)"
        android:textColor="#D4A017"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <EditText
        android:id="@+id/txtModeloDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="Ej. Versa"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="15sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:inputType="textCapWords" />

    <!-- Color -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="COLOR"
        android:textColor="#D4A017"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <EditText
        android:id="@+id/txtColorDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="Ej. Gris"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="15sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:inputType="textCapWords" />

    <!-- Placa -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="PLACA"
        android:textColor="#D4A017"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <EditText
        android:id="@+id/txtPlacaDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="Ej. ABC1234"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:textSize="15sp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:inputType="textCapCharacters" />

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:id="@+id/btnCancelarDialog"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="25dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:cardElevation="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Cancelar"
                android:textColor="#AAAAAA"
                android:textStyle="bold"
                android:textSize="15sp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnGuardarDialog"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="25dp"
            app:cardBackgroundColor="@color/gold_primary"
            app:cardElevation="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Guardar"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="15sp" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>
