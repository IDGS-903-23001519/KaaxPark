<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_glass"
    android:padding="16dp"
    tools:context=".Admin.Cajones">

    <TextView
        android:id="@+id/lblTituloCajones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Gestión de cajones"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/lblSubtituloCajones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Monitorea y controla los cajones"
        android:textColor="#A0A0A0"
        android:textSize="13sp"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblTituloCajones" />

    <EditText
        android:id="@+id/txtBuscarCajon"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_buscador_cajones"
        android:hint="Buscar cajón..."
        android:textColorHint="#666666"
        android:textColor="#FFFFFF"
        android:paddingStart="40dp"
        android:paddingEnd="16dp"
        android:textSize="14sp"
        android:inputType="text"
        app:layout_constraintEnd_toStartOf="@id/btnFiltro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblSubtituloCajones" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/icon_buscar"
        app:layout_constraintBottom_toBottomOf="@id/txtBuscarCajon"
        app:layout_constraintStart_toStartOf="@id/txtBuscarCajon"
        app:layout_constraintTop_toTopOf="@id/txtBuscarCajon"
        app:tint="#666666" />

    <ImageButton
        android:id="@+id/btnFiltro"
        android:layout_width="54dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_filtro_cajones"
        android:src="@drawable/icon_filtro"
        app:layout_constraintBottom_toBottomOf="@id/txtBuscarCajon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtBuscarCajon"
        app:tint="#FFFFFF" />

    <LinearLayout
        android:id="@+id/layoutContadores"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/txtBuscarCajon">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:cardCornerRadius="16dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp">
                <TextView
                    android:id="@+id/lblTotalTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total"
                    android:textColor="#B0B5B8"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/txtTotalCajones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/lblTotalTag"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:cardCornerRadius="16dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp">
                <TextView
                    android:id="@+id/lblOcupadosTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ocupados"
                    android:textColor="#B0B5B8"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/txtOcupadosCajones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/lblOcupadosTag"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtOcupadosPorcentaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:text="0%"
                    android:textColor="#B0B5B8"
                    android:textSize="11sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:cardCornerRadius="16dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp">
                <TextView
                    android:id="@+id/lblDisponiblesTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disponibles"
                    android:textColor="#B0B5B8"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/txtDisponiblesCajones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/lblDisponiblesTag"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/txtDisponiblesPorcentaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:text="0%"
                    android:textColor="#B0B5B8"
                    android:textSize="11sp" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/layoutContadores"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/layoutListaCajones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/lblSinCajones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No se encontraron cajones."
        android:textColor="#9E9E9E"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutContadores"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
