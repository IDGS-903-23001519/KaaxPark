<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_base_admin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/btnPerfil"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="25dp"
        android:src="@drawable/icon_perfil"
        android:contentDescription="Perfil de Administrador"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/containerDashboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/btnPerfil"
        app:layout_constraintBottom_toTopOf="@id/menuInferiorAdmin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/menuInferiorAdmin"
        android:layout_width="0dp"
        android:layout_height="95dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/btnMenuDashboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">
            <ImageView
                android:id="@+id/imgNavDashboard"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_dashboard"/>
            <TextView
                android:id="@+id/txtNavDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMenuCajones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">
            <ImageView
                android:id="@+id/imgNavCajones"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_cajones"/>
            <TextView
                android:id="@+id/txtNavCajones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cajones"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:gravity="center"
            android:orientation="vertical">
            <androidx.cardview.widget.CardView
                android:id="@+id/btnMenuCentralK"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="35dp"
                app:cardBackgroundColor="#2A2415">
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:src="@drawable/logo" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMenuReporte"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">
            <ImageView
                android:id="@+id/imgNavReporte"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_reporte"/>
            <TextView
                android:id="@+id/txtNavReporte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reporte"
                android:textColor="#FFFFFF"
                android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMenuSustentabilidad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">
            <ImageView
                android:id="@+id/imgNavSustentabilidad"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_sustentabilidad"/>
            <TextView
                android:id="@+id/txtNavSustentabilidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sustentabilidad"
                android:textColor="#FFFFFF"
                android:textSize="10sp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>