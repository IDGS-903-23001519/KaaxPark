<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_base_admin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_glass">

    <!-- Header / Barra Superior -->
    <ImageView
        android:id="@+id/btnPerfil"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="25dp"
        android:src="@drawable/icon_perfil"
        android:contentDescription="Perfil de Administrador"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <FrameLayout
        android:id="@+id/containerDashboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/btnPerfil"
        app:layout_constraintBottom_toTopOf="@id/menuInferiorAdmin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Barra de Navegación Inferior -->
    <LinearLayout
        android:id="@+id/menuInferiorAdmin"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_nav_glass"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/btnMenuDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="8dp">
            <ImageView
                android:id="@+id/imgNavDashboard"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/icon_dashboard"
                app:tint="#8CFFFFFF" />
            <TextView
                android:id="@+id/txtNavDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Dashboard"
                android:textColor="#8CFFFFFF"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMenuCajones"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="8dp">
            <ImageView
                android:id="@+id/imgNavCajones"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/icon_cajones"
                app:tint="#8CFFFFFF" />
            <TextView
                android:id="@+id/txtNavCajones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cajones"
                android:textColor="#8CFFFFFF"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- Botón Central - Logo de la App -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/btnMenuCentralK"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="32dp"
                app:cardElevation="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_fab_gold"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/logo"
                        app:tint="#241705" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMenuReporte"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="8dp">
            <ImageView
                android:id="@+id/imgNavReporte"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/icon_reporte"
                app:tint="#8CFFFFFF" />
            <TextView
                android:id="@+id/txtNavReporte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Reporte"
                android:textColor="#8CFFFFFF"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMenuSustentabilidad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="8dp">
            <ImageView
                android:id="@+id/imgNavSustentabilidad"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/icon_sustentabilidad"
                app:tint="#8CFFFFFF" />
            <TextView
                android:id="@+id/txtNavSustentabilidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sustentabilidad"
                android:textColor="#8CFFFFFF"
                android:textSize="9sp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
