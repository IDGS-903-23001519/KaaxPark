<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_base_admin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_glass"
    android:fitsSystemWindows="true">

    <!-- ================= HEADER ================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerAdmin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        android:paddingVertical="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnPerfil"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/icon_perfil"
            android:contentDescription="Perfil"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Título centralizado Admin -->
        <TextView
            android:id="@+id/txtTituloBaseAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Admin Panel"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= CONTENIDO ================= -->

    <FrameLayout
        android:id="@+id/containerDashboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerAdmin"
        app:layout_constraintBottom_toTopOf="@id/menuInferiorAdmin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ================= MENÚ ================= -->

    <LinearLayout
        android:id="@+id/menuInferiorAdmin"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_nav_glass"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Dashboard -->

        <LinearLayout
            android:id="@+id/btnMenuDashboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavDashboard"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_dashboard"/>

            <TextView
                android:id="@+id/txtNavDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textColor="#8CFFFFFF"
                android:textSize="11sp"
                android:maxLines="1"/>

        </LinearLayout>

        <!-- Cajones -->

        <LinearLayout
            android:id="@+id/btnMenuCajones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavCajones"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_cajones"/>

            <TextView
                android:id="@+id/txtNavCajones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cajones"
                android:textColor="#8CFFFFFF"
                android:textSize="11sp"
                android:maxLines="1"/>

        </LinearLayout>

        <!-- Botón Central -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/btnMenuCentralK"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#F5C55A"
                app:cardCornerRadius="35dp"
                app:cardElevation="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:src="@drawable/logo"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Reporte -->

        <LinearLayout
            android:id="@+id/btnMenuReporte"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavReporte"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_reporte"/>

            <TextView
                android:id="@+id/txtNavReporte"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reporte"
                android:textColor="#8CFFFFFF"
                android:textSize="11sp"
                android:maxLines="1"/>

        </LinearLayout>

        <!-- Sustentabilidad -->

        <LinearLayout
            android:id="@+id/btnMenuSustentabilidad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavSustentabilidad"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/icon_sustentabilidad"/>

            <TextView
                android:id="@+id/txtNavSustentabilidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sustentab."
                android:textColor="#8CFFFFFF"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>