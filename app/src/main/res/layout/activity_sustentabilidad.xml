<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp"
    tools:context=".Admin.Sustentabilidad">

    <TextView
        android:id="@+id/lblTituloSustentabilidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="96dp"
        android:layout_marginTop="8dp"
        android:text="Sustentabilidad"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/lblSubtituloSustentabilidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="104dp"
        android:layout_marginTop="2dp"
        android:text="Indicadores ambientales"
        android:textColor="#A0A0A0"
        android:textSize="14sp"
        android:textStyle="italic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblTituloSustentabilidad" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutIndicadoresMes"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_recuadro_sutil"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toBottomOf="@id/lblSubtituloSustentabilidad">

        <TextView
            android:id="@+id/lblTagIndicadores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Indicadores del mes"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Junio 2026"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="italic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblTagIndicadores" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/layoutCardsAmbientales"
        android:layout_width="match_parent"
        android:layout_height="165dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/layoutIndicadoresMes">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            app:cardBackgroundColor="#1F2022"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">
                <TextView
                    android:id="@+id/tagCo2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Co2 Evitado"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
                <TextView
                    android:id="@+id/numCo2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.45"
                    android:textColor="#2ECC71"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/lblUnidadCo2"
                    app:layout_constraintTop_toBottomOf="@id/tagCo2"
                    app:layout_constraintStart_toStartOf="parent" />
                <TextView
                    android:id="@+id/lblUnidadCo2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toneladas"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:textStyle="italic"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            app:cardBackgroundColor="#1F2022"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">
                <TextView
                    android:id="@+id/tagArboles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Arboles Eq."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
                <TextView
                    android:id="@+id/numArboles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textColor="#2ECC71"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/lblUnidadArboles"
                    app:layout_constraintTop_toBottomOf="@id/tagArboles"
                    app:layout_constraintStart_toStartOf="parent" />
                <TextView
                    android:id="@+id/lblUnidadArboles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Arboles"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:textStyle="italic"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            app:cardBackgroundColor="#1F2022"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">
                <TextView
                    android:id="@+id/tagEnergia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Energia ahorrada"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
                <TextView
                    android:id="@+id/numEnergia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1,245"
                    android:textColor="#2ECC71"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@id/lblUnidadEnergia"
                    app:layout_constraintTop_toBottomOf="@id/tagEnergia"
                    app:layout_constraintStart_toStartOf="parent" />
                <TextView
                    android:id="@+id/lblUnidadEnergia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="kWh"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:textStyle="italic"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <TextView
        android:id="@+id/lblImpactoTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Impacto Ambiental"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutCardsAmbientales" />

    <FrameLayout
        android:id="@+id/containerGraficaBarras"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="10dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/lblImpactoTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgGraficaBarrasSimulada"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/bg_grafica_barras_mockup"
            tools:ignore="ContentDescription" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>