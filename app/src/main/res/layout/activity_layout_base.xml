<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_glass">

    <FrameLayout
        android:id="@+id/contenedor_paginas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/menuInferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/btnPerfil"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:src="@drawable/icon_perfil"
        android:contentDescription="Perfil de Administrador"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Nuevo botón: acceso a "Mis vehículos" (agregar / seleccionar vehículo en uso) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnVehiculos"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@android:color/transparent"
        android:background="@drawable/bg_glass_card"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgBtnVehiculos"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="Mis vehículos"
            android:src="@drawable/icon_vehiculo"
            app:tint="#F5C55A" />
    </androidx.cardview.widget.CardView>



    <LinearLayout
        android:id="@+id/menuInferior"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_bottom_nav_glass"
        android:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/btnMenuEstancia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">
            <ImageView
                android:id="@+id/imgEstancia"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/icon_estancia"
                tools:ignore="ContentDescription" />
            <TextView
                android:id="@+id/txtNavEstancia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estancia"
                android:textColor="#8CFFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMenuHistorial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">
            <ImageView
                android:id="@+id/imgHistorial"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/icon_historial"
                tools:ignore="ContentDescription" />
            <TextView
                android:id="@+id/txtNavHistorial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historial"
                android:textColor="#8CFFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:gravity="center"
            android:orientation="vertical">
            <androidx.cardview.widget.CardView
                android:id="@+id/btnMenuQR"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="38dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="15dp"
                    android:src="@drawable/icon_qr"
                    app:tint="#241705"
                    android:background="#F5C55A"
                    tools:ignore="ContentDescription" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMenuVehiculo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">
            <ImageView
                android:id="@+id/imgVehiculo"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/icon_vehiculo"
                tools:ignore="ContentDescription" />
            <TextView
                android:id="@+id/txtNavVehiculo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehículo"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMenuPago"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">
            <ImageView
                android:id="@+id/imgPago"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/icon_pago"
                tools:ignore="ContentDescription" />
            <TextView
                android:id="@+id/txtNavPago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pago"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Botón flotante Asistente IA -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnAsistenteIA"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="110dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/glass_surface"
        app:cardCornerRadius="27dp"
        app:cardElevation="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgAsistenteIA"
            android:layout_width="34dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="Asistente IA"
            android:src="@drawable/logo" />
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
